# =====================================================================
# FinSight — Environment Configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
# Backend port
PORT=8000

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# PostgreSQL (used by docker-compose). For local quick-start without
# Postgres, you may point this at SQLite:
#   DATABASE_URL=sqlite:///./finsight.db
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# Seed users (created on first startup)
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@finsight.app
ADMIN_PASSWORD=admin1234
DEMO_USER_EMAIL=demo@finsight.app
DEMO_USER_PASSWORD=demo1234

# ---------------------------------------------------------------------
# AI Copilot (OpenRouter)
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Leave empty to disable AI; Copilot still works in "local analysis" mode.
AI_ENABLED=true

# ---------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------
# Options: demo | finnhub
MARKET_DATA_PROVIDER=demo
FINNHUB_API_KEY=

# ---------------------------------------------------------------------
# News
# ---------------------------------------------------------------------
# Options: demo | newsapi | finnhub
NEWS_PROVIDER=demo
NEWSAPI_KEY=

# ---------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------
# When true, market/news data is generated locally and clearly labeled
# as simulated. The rest of the app is fully functional.
DEMO_MODE=true

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000
