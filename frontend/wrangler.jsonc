{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finsight",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
